<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.agentmemory.agentmemory</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/agentmemory</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/devinmartinolich/.agentmemory</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
		<key>AGENTMEMORY_URL</key>
		<string>http://localhost:3111</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/Users/devinmartinolich/.agentmemory/launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/devinmartinolich/.agentmemory/launchd.stderr.log</string>
</dict>
</plist>
